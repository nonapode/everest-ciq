#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

fail() { echo "ERROR: $*" >&2; exit 1; }
command -v python3 >/dev/null || fail "python3 is required (enter nix develop)."
python3 - <<'PY'
from pathlib import Path
import sys
import xml.etree.ElementTree as ET

root = Path.cwd()
required = ["manifest.xml", "monkey.jungle", "source", "resources"]
missing = [name for name in required if not (root / name).exists()]
if missing:
    print("Missing project files: " + ", ".join(missing), file=sys.stderr)
    sys.exit(1)
try:
    manifest = ET.parse(root / "manifest.xml").getroot()
except ET.ParseError as exc:
    print(f"Invalid manifest.xml: {exc}", file=sys.stderr)
    sys.exit(1)
ns = {"iq": "http://www.garmin.com/xml/connectiq"}
products = {node.attrib.get("id") for node in manifest.findall(".//iq:product", ns)}
if "edge840" not in products:
    print("manifest.xml does not declare the edge840 product", file=sys.stderr)
    sys.exit(1)
source_files = list((root / "source").glob("*.mc"))
if not source_files:
    print("No Monkey C files found under source/", file=sys.stderr)
    sys.exit(1)
print(f"Static project checks passed: {len(source_files)} Monkey C source files; edge840 target present; manifest XML valid.")
PY
