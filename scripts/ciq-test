#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# This is a smoke-test entry point, not a substitute for simulator/device tests.
./scripts/ciq-check
./scripts/ciq-build

if command -v monkeydo >/dev/null 2>&1; then
  echo "monkeydo is available. Simulator execution requires a running Connect IQ simulator and any required simulator device configuration."
  echo "No automated Monkey C unit-test suite is currently included in this project."
else
  echo "Compile smoke test passed. monkeydo not found; simulator run skipped."
fi
