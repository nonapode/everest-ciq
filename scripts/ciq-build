#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if ! command -v monkeyc >/dev/null 2>&1; then
  echo "ERROR: monkeyc not found. Install Garmin Connect IQ SDK and set CIQ_SDK or add its bin/ directory to PATH." >&2
  exit 127
fi

./scripts/ciq-check
mkdir -p build
args=(-f monkey.jungle -o build/everest-edge840.prg -d edge840)
if [[ -n "${CIQ_DEVELOPER_KEY:-}" ]]; then
  [[ -f "$CIQ_DEVELOPER_KEY" ]] || { echo "ERROR: CIQ_DEVELOPER_KEY does not point to a file: $CIQ_DEVELOPER_KEY" >&2; exit 2; }
  args+=(-y "$CIQ_DEVELOPER_KEY")
else
  echo "NOTE: CIQ_DEVELOPER_KEY is unset; attempting an unsigned/local SDK compile. If this SDK requires signing, set CIQ_DEVELOPER_KEY=/path/to/developer_key.der." >&2
fi
printf 'Running:'; printf ' %q' monkeyc "${args[@]}"; printf '\n'
monkeyc "${args[@]}"
echo "Build output: build/everest-edge840.prg"
